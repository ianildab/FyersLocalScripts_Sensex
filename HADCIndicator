        #df['ATR'] = ta.volatility.AverageTrueRange(df.high,df.low,df.close,window=2,fillna=False).average_true_range()
        df.dropna(inplace=True)
        #print(script+' '+str(max(df.high)))

        # === HADC (Heikin Ashi Decisive Candle) - inline ===
        wick_threshold_pct = 0.05
        wick_threshold = wick_threshold_pct / 100.0

        df['haClose'] = (df['open'] + df['high'] + df['low'] + df['close']) / 4

        ha_open = [None] * len(df)
        for i in range(len(df)):
            if i == 0:
                ha_open[i] = (df['open'].iloc[i] + df['close'].iloc[i]) / 2
            else:
                ha_open[i] = (ha_open[i - 1] + df['haClose'].iloc[i - 1]) / 2
        df['haOpen'] = ha_open

        df['haHigh'] = df[['high', 'haOpen', 'haClose']].max(axis=1)
        df['haLow'] = df[['low', 'haOpen', 'haClose']].min(axis=1)

        df['isBull'] = df['haClose'] >= df['haOpen']
        df['isBear'] = ~df['isBull']

        df['rangeHA'] = df['haHigh'] - df['haLow']
        df['lowerWick'] = df[['haOpen', 'haClose']].min(axis=1) - df['haLow']
        df['upperWick'] = df['haHigh'] - df[['haOpen', 'haClose']].max(axis=1)

        df['noLowerWick'] = df['lowerWick'] <= (df['rangeHA'] * wick_threshold)
        df['noUpperWick'] = df['upperWick'] <= (df['rangeHA'] * wick_threshold)

        df['bullDecisive'] = df['isBull'] & df['noLowerWick']
        df['bearDecisive'] = df['isBear'] & df['noUpperWick']

        prev_bull_decisive = df['bullDecisive'].shift(1).fillna(False)
        prev_bear_decisive = df['bearDecisive'].shift(1).fillna(False)

        df['continuationBull'] = df['isBull'] & prev_bull_decisive
        df['continuationBear'] = df['isBear'] & prev_bear_decisive

        df['HADC_signal'] = None
        df.loc[df['bullDecisive'] & ~df['continuationBull'], 'HADC_signal'] = 'B'
        df.loc[df['continuationBull'], 'HADC_signal'] = 'H'
        df.loc[df['bearDecisive'] & ~df['continuationBear'], 'HADC_signal'] = 'S'
        df.loc[df['continuationBear'], 'HADC_signal'] = 'H'
        # === end HADC ===
        df.dropna(inplace=True)

        last_signal = df['HADC_signal'].iloc[-1]
        last_time = df.index[-1]
        last_close = df['close'].iloc[-1]

