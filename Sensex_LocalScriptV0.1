# ---- Code for expiry fetch dynamically - Start ---- #
def is_holiday(d: datetime.date) -> bool:
    return d in HOLIDAYS

def is_weekend(d: datetime.date) -> bool:
    return d.weekday() >= 5  # 5=Saturday, 6=Sunday

def previous_working_day(d: datetime.date) -> datetime.date:
    """Shift back to the previous Mon–Fri day that is not a holiday."""
    while is_weekend(d) or is_holiday(d):
        d -= datetime.timedelta(days=1)
    return d

def last_tuesday_of_month(year: int, month: int) -> datetime.date:
    last_day = calendar.monthrange(year, month)[1]
    d = datetime.date(year, month, last_day)
    while d.weekday() != calendar.THURSDAY:
        d -= datetime.timedelta(days=1)
    return d

def monthly_expiry_for_month(year: int, month: int) -> datetime.date:
    lt = last_tuesday_of_month(year, month)
    if is_holiday(lt):
        return previous_working_day(lt - datetime.timedelta(days=1))
    return lt

def month_code_weekly(month: int) -> str:
    return {10: "O", 11: "N", 12: "D"}.get(month, str(month))

def month_abbr_monthly(d: datetime.date) -> str:
    return d.strftime("%b").upper()

def format_expiry(d: datetime.date, monthly_expiry: datetime.date) -> str:
    yy = str(d.year)[-2:]
    if d == monthly_expiry:
        return f"{yy}{month_abbr_monthly(d)}"   # Monthly format
    return f"{yy}{month_code_weekly(d.month)}{d.day:02d}"  # Weekly format

def next_expiries(n=2):
    today = datetime.date.today()
    d = today + datetime.timedelta(days=1)
    out = []
    while len(out) < n:
        if d.weekday() == calendar.THURSDAY:
            expiry_date = d
            if is_holiday(expiry_date):
                expiry_date = previous_working_day(expiry_date - datetime.timedelta(days=1))
            monthly_expiry = monthly_expiry_for_month(d.year, d.month)
            code = format_expiry(expiry_date, monthly_expiry)
            days_to_expiry = (expiry_date - today).days
            out.append((expiry_date, code, days_to_expiry))
        d += datetime.timedelta(days=1)
    return out
# ---- Code for expiry fetch dynamically - End ---- #
